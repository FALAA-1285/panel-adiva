# Salin ke .env.produksi di VPS, isi yang kosong, jangan pernah di-commit.
#   cp .env.produksi.example .env.produksi && nano .env.produksi

APP_NAME="Panel Adiva"
APP_ENV=production
# salin dari .env lokal, atau buat baru: php artisan key:generate --show
# kalau diganti, semua sesi dan data terenkripsi lama tidak terbaca lagi
APP_KEY=
APP_DEBUG=false
APP_URL=http://158.220.117.56:8080

# tanpa ini tanggal muncul "Monday, 28 Sep", bukan "Senin, 28 Sep"
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

# wajib false di produksi: true membekukan jam aplikasi ke 28 Sep 2026 dan
# memaksa semua driver bot memakai tiruan
APP_DEMO=false

# ---- database (Supabase)
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

# ---- sesi, antrean, cache
SESSION_DRIVER=database
SESSION_LIFETIME=720
# HARUS false selama panel diakses lewat http:// tanpa TLS.
# Kalau true, browser menolak mengirim cookie dan login selalu gagal.
# Ubah ke true begitu HTTPS dipasang.
SESSION_SECURE_COOKIE=false
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=public

# log ke stderr supaya terbaca lewat `docker compose logs`
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# ---- bot
# tiruan = tidak mengirim apa pun (aman untuk uji coba)
# lokal   = panel mengerjakan sendiri perintah order, invoice, dan pengiriman
# langsung= semuanya lewat n8n seperti sebelumnya
BOT_DRIVER=tiruan

# WAHA dan n8n milik Bang Bana (compose.bot.yml), bukan yang di port 3001/5678
# — keduanya itu milik proyek lain. host.docker.internal menunjuk ke host VPS.
WAHA_URL=http://host.docker.internal:3002
WAHA_API_KEY=
WAHA_WEBHOOK_SECRET=
WAHA_TIMEOUT=20

N8N_WEBHOOK_URL=http://host.docker.internal:5679/webhook/
N8N_WEBHOOK_SECRET=
N8N_API_URL=http://host.docker.internal:5679/api/v1
N8N_API_KEY=
# dibuka di browser Anda lewat SSH tunnel, bukan alamat publik
N8N_EDITOR_URL=http://127.0.0.1:5679

# MENGANTAR_API_KEY tidak di sini — tersimpan di tabel config_toko,
# diubah dari halaman Pengaturan. GEMINI_API_KEY tidak diperlukan panel.
