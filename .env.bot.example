# Salin ke .env.bot di VPS lalu isi. Jangan pernah di-commit.
#   cp .env.bot.example .env.bot
#   sed -i "s/^N8N_ENCRYPTION_KEY=.*/N8N_ENCRYPTION_KEY=$(openssl rand -hex 24)/" .env.bot
#   sed -i "s/^WAHA_API_KEY=.*/WAHA_API_KEY=$(openssl rand -hex 24)/" .env.bot

# Dibuat SEKALI lalu tidak pernah diganti. Kalau hilang, semua credential di n8n
# tidak bisa didekripsi lagi dan harus diisi ulang dari nol.
N8N_ENCRYPTION_KEY=

# Alamat yang ditampilkan node Webhook n8n. Biarkan loopback selama belum ada domain.
N8N_WEBHOOK_URL_PUBLIK=http://127.0.0.1:5679/

# Nilai yang sama harus diisikan ke WAHA_API_KEY di .env.produksi panel.
WAHA_API_KEY=

WAHA_DASHBOARD_USERNAME=falah
WAHA_DASHBOARD_PASSWORD=
