APP_NAME="Panel Adiva"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_DEMO=false

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=panel_adiva
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Adiva's bot (docs/kontrak-n8n.md). tiruan = nothing is sent; langsung = n8n + WAHA;
# lokal = the panel does what it has taken over from n8n, the rest goes through n8n
BOT_DRIVER=tiruan
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
N8N_TIMEOUT=15
N8N_TIMEOUT_UJI=60
N8N_TIMEOUT_JAWAB=180
N8N_EDITOR_URL=
N8N_API_URL=
N8N_API_KEY=
# Percakapan menampilkan chat chatbot utama dari Data Table n8n (hanya lihat), lihat docs/kontrak-n8n.md
N8N_SINKRON_CHAT=false
# Accurate Online (database Bana Food): barang Toko Sawojajar, hanya baca.
# OAuth: Client ID/Secret aplikasi Accurate, lalu "Sambungkan Accurate" di Katalog → Barang toko.
# URL OAuth Callback aplikasi = ACCURATE_REDIRECT_URI (bawaan: APP_URL/accurate/kembali).
ACCURATE_CLIENT_ID=
ACCURATE_CLIENT_SECRET=
ACCURATE_REDIRECT_URI=
# atau API Token (bukan App Key)
ACCURATE_API_TOKEN=
ACCURATE_SIGNATURE_SECRET=
ACCURATE_DB_ID=2743429

WAHA_URL=
WAHA_API_KEY=
WAHA_TIMEOUT=15
WAHA_WEBHOOK_SECRET=
# kode masuk/daftar/reset staf lewat WAHA walau BOT_DRIVER=tiruan
WAHA_KODE_STAF=false
# gerbang WAHA lewat n8n (Vercel tidak bisa menjangkau WAHA): URL webhook panel-waha dan rahasia HMAC-nya
WAHA_GERBANG_URL=
WAHA_GERBANG_SECRET=
